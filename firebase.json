{
  "auth": {
      "providers": {
        "emailPassword": true,
        "googleSignIn": {
        "oAuthBrandDisplayName": "Kok calis",
        "supportEmail": "ziya.okumus@gmail.com"
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "location": "europe-west1"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "schema/**",
      "dumps/**",
      "**/*.py",
      "README.md",
      "package.json",
      "package-lock.json",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
